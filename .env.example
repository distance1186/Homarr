# Homarr Environment Variables
# Copy this file to .env and update with your values
# The .env file is gitignored for security

# Timezone
TZ=America/New_York

# Required: 64-character hex string for encrypting credentials stored in Homarr
# Generate on the Linux host with: openssl rand -hex 32
SECRET_ENCRYPTION_KEY=

# Optional: Base URL (if behind reverse proxy)
# BASE_URL=https://homarr.yourdomain.com

# Service API keys (add to Homarr integrations via the UI instead where possible)
# PLEX_TOKEN=your-plex-token
